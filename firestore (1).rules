rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Data inti silsilah (nama, tanggal lahir, alamat, dst) dan struktur pohon (rootIds)
    // -> siapa pun yang sudah login (anggota keluarga) boleh baca & tulis
    match /people/{personId} {
      allow read, write: if request.auth != null;
    }
    match /meta/{docId} {
      allow read, write: if request.auth != null;
    }

    // Profil kontributor (nama & wilayah yang tampil di riwayat perubahan)
    match /users/{uid} {
      allow read, write: if request.auth != null;
    }

    // Riwayat perubahan: siapa pun yang login boleh baca & MENAMBAH catatan baru,
    // tapi TIDAK boleh mengubah/menghapus catatan yang sudah ada (supaya riwayat
    // tetap bisa dipercaya sebagai jejak audit)
    match /auditLog/{docId} {
      allow read, create: if request.auth != null;
    }

    // Selain koleksi di atas, tetap tertutup rapat secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
